<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.openclaw.event-watcher</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/python3</string>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/scripts/watcher.py</string>
      <string>--config</string>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/event_watcher.yaml</string>
      <string>--state</string>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/event_watcher_state.json</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>EVENT_WATCHER_CONFIG</key>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/event_watcher.yaml</string>
      <key>EVENT_WATCHER_STATE</key>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/event_watcher_state.json</string>
      <key>EVENT_WATCHER_DEAD_LETTER</key>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/dead_letter.jsonl</string>
      <key>EVENT_WATCHER_LOG</key>
      <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher/event_watcher_events.jsonl</string>
      <key>REDIS_URL</key>
      <string>redis://localhost:6379/0</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/root/.openclaw/workspace/event-watcher-skill/event-watcher</string>
    <key>StandardOutPath</key>
    <string>/tmp/event-watcher.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/event-watcher.err.log</string>
  </dict>
</plist>
