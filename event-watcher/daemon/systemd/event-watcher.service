[Unit]
Description=OpenClaw Event Watcher
After=network.target

[Service]
Type=simple
User=eventwatcher
WorkingDirectory=/root/.openclaw/workspace/event-watcher-skill/event-watcher
EnvironmentFile=/etc/event-watcher.env
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/event-watcher-skill/event-watcher/scripts/watcher.py --config ${EVENT_WATCHER_CONFIG} --state ${EVENT_WATCHER_STATE}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
